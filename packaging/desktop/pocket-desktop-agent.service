# Pocket Desktop Agent: the computer side of Pocket Dock (docs/development/dock.md).
# A user service: it runs as the desktop user, never as root, and needs the user's
# session bus (notifications, MPRIS). Installed by scripts/dock-pair.sh.
[Unit]
Description=Pocket Desktop Agent (Pocket OS Dock)
Documentation=https://github.com/kitnew/Pocket-OS/blob/main/docs/development/dock.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/pocket-desktop-agent run
# Re-read config.json (grants, apps, destinations, workflows) without a restart.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
Environment=POCKET_AGENT_LOG=info
# It needs its configuration (written when the owner approves an access request) and
# the session bus. Applications it starts run as transient user services (systemd-run),
# so they do NOT inherit this sandbox.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/pocket-desktop-agent
PrivateTmp=yes

[Install]
WantedBy=graphical-session.target
